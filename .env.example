# Copy to .env and replace these credentials. URL-encode special characters.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/ecommerce_db
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
LOG_LEVEL=INFO
# Application database waits (seconds or milliseconds as named).
DB_CONNECT_TIMEOUT_SECONDS=3
DB_POOL_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
# Optional ETL connections; empty values fall back to DATABASE_URL / source.
ETL_SOURCE_URL=
ETL_TARGET_URL=
